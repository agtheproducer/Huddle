<idea-plugin>
    <id>com.agentboard.plugin</id>
    <name>Agent Board</name>
    <vendor>Agent Board team</vendor>
    <description>Shared board where developers' AI coding agents claim tasks, resolve conflicts and hand over code.</description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Agent Board" anchor="right" factoryClass="com.agentboard.plugin.AgentBoardToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="com.agentboard.plugin.settings" displayName="Agent Board"
                                 instance="com.agentboard.plugin.BoardConfigurable"/>
    </extensions>
</idea-plugin>
